# Written by `neon env pull` (or `neon init`) into .env.local, which git ignores. Never commit real values.
# The app only reads NEON_AUTH_BASE_URL and NEON_DATA_API_URL (see app.config.js); the rest are for
# npm run db:migrate / db:seed. Leave them out, or set EXPO_PUBLIC_DEMO=1, to run the on-device demo.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxx-pooler.c-16.us-east-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@ep-xxx.c-16.us-east-1.aws.neon.tech/neondb?sslmode=require
NEON_AUTH_BASE_URL=https://ep-xxx.neonauth.c-16.us-east-1.aws.neon.tech/neondb/auth
NEON_DATA_API_URL=https://ep-xxx.apirest.c-16.us-east-1.aws.neon.tech/neondb/rest/v1
# EXPO_PUBLIC_DEMO=1
