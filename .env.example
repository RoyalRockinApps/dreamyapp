# Copy to .env.local (git ignores it). Never commit real values.
# The app reads SUPABASE_URL and SUPABASE_PUBLISHABLE_KEY (see app.config.js); both are public by design.
# SUPABASE_DB_URL is only for `npm run db:seed` and is a secret (it contains the database password).
# Leave the Supabase values out, or set EXPO_PUBLIC_DEMO=1, to run the on-device demo.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_DB_URL=postgresql://postgres.YOUR-PROJECT-REF:PASSWORD@aws-0-us-east-1.pooler.supabase.com:5432/postgres
# EXPO_PUBLIC_DEMO=1
